# RailSync 2.0 — Environment Configuration Example
# Copy this to .env and fill in your values.

# Supabase PostgreSQL (required)
SUPABASE_DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional API key for mutation endpoints
API_KEY=

# Logging
LOG_LEVEL=INFO

# Layer integration mode: "standalone" uses built-in adapters, "external" calls separate modules
LAYER_MODE=standalone
